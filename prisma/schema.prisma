// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  admin
  user
  premium_user
}
enum NotificationType{
  welcome
  new_song
  new_album
  new_playlist
}
model User {
  id            String    @id @default(uuid())
  firstname     String
  lastname      String
  email         String    @unique
  phone         String
  passwordHash  String    @map("password_hash")
  role          Role
  imageUrl      String?   @map("image_url")
  imagePublicId String?   @map("image_public_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastLogin     DateTime? @map("last_login")

  playlists     Playlist[]
  albums        Album[]
  songs         Song[]
  notifications Notification[]

  @@map("users")
}

model Album {
  id            String   @id @default(uuid())
  title         String
  artist        String
  description   String
  bgColor       String
  isPublic      Boolean

  // Cloudinary-hosted cover image
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")

  // Relation to uploading User
  uploaderId    String   @map("uploader_id")
  uploader      User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  notifications Notification[]

  songs         Song[]

  @@map("albums")
}

model Song {
  id            String   @id @default(uuid())
  title         String
  artist        String
  durationSec   Int?     @map("duration_sec")
  description   String
  isPublic      Boolean

  // Cloudinary-hosted audio file (required)
  audioUrl      String   @map("audio_url")
  audioPublicId String   @map("audio_public_id")

  // Cloudinary-hosted cover/artwork image (optional)
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")

  // Relation to Album (optional)
  albumId       String?  @map("album_id")
  album         Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  // Relation to uploading User
  uploaderId    String   @map("uploader_id")
  uploader      User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  notifications Notification[]

  playlistEntries PlaylistSong[]

  @@map("songs")
}

model Playlist {
  id            String   @id @default(uuid())
  name          String
  description   String
  isPublic      Boolean

  // Cloudinary-hosted cover image
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")

  ownerId       String   @map("owner_id")
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  notifications Notification[]

  songEntries   PlaylistSong[]

  @@map("playlists")
}

// Explicit join table for the Playlist <-> Song many-to-many relationship.
model PlaylistSong {
  playlistId String   @map("playlist_id")
  songId     String   @map("song_id")
  addedAt    DateTime @default(now()) @map("added_at")

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@map("playlist_songs")
}

model Notification{
  id  String @id @default(uuid())
  type NotificationType
  title String
  message String
  isRead Boolean @default(false) @map("is_read")

  songId String? @map("song_id")
  song Song?  @relation(fields: [songId], references: [id], onDelete: SetNull)

  albumId String? @map("album_id")
  album Album? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  playlistId String? @map("playlist_id")
  playlist Playlist? @relation(fields: [playlistId], references: [id] , onDelete: SetNull)

  userId String? @map("user_id")
  user User? @relation(fields: [userId], references: [id] , onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, isRead])
  @@map("notifications")

}